{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],

    // NEW/UPDATED FIELDS:
    // 1) Set baseUrl to "." (the project root)
    // 2) Create a specific path alias for "@/library/*"
    "baseUrl": ".",
    "paths": {
      // This keeps your existing "@/*" => "src/*" mapping
      "@/*": ["./src/*"],
      // NEW: Map "@/library/*" to your "src/library" folder
      "@/library/*": ["./src/library/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
